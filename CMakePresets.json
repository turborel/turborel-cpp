{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_COMPILE_WARNING_AS_ERROR": "ON",
        "TURBOREL_CPP_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "debug",
      "description": "Debug build, tests and the source rules",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TURBOREL_CPP_FAULTS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "release",
      "description": "Optimized build and tests",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "asan-ubsan",
      "displayName": "asan-ubsan",
      "description": "Tests under AddressSanitizer and UndefinedBehaviorSanitizer (RULES.md D14)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TURBOREL_CPP_SANITIZE": "ON",
        "TURBOREL_CPP_FAULTS": "ON"
      }
    },
    {
      "name": "coverage",
      "displayName": "coverage",
      "description": "Tests measured by Clang's source-based coverage, against the floors (RULES.md D7)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TURBOREL_CPP_COVERAGE": "ON",
        "TURBOREL_CPP_FAULTS": "ON"
      }
    },
    {
      "name": "verify",
      "displayName": "verify",
      "description": "Every check a change must pass: clang-tidy, format, source rules, docs and tests (R-PROC-1)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TURBOREL_CPP_LINT": "ON",
        "TURBOREL_CPP_FAULTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release"
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan",
      "configuration": "Debug"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "configuration": "Debug"
    },
    {
      "name": "verify",
      "configurePreset": "verify",
      "configuration": "Debug"
    },
    {
      "name": "coverage-report",
      "configurePreset": "coverage",
      "configuration": "Debug",
      "targets": [
        "coverage-report"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      },
      "environment": {
        "ASAN_OPTIONS": "abort_on_error=1:strict_string_checks=1:detect_stack_use_after_return=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "verify",
      "configurePreset": "verify",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "debug",
      "displayName": "debug",
      "description": "Debug build, tests and the source rules",
      "steps": [
        {
          "type": "configure",
          "name": "debug"
        },
        {
          "type": "build",
          "name": "debug"
        },
        {
          "type": "test",
          "name": "debug"
        }
      ]
    },
    {
      "name": "release",
      "displayName": "release",
      "description": "Optimized build and tests",
      "steps": [
        {
          "type": "configure",
          "name": "release"
        },
        {
          "type": "build",
          "name": "release"
        },
        {
          "type": "test",
          "name": "release"
        }
      ]
    },
    {
      "name": "asan-ubsan",
      "displayName": "asan-ubsan",
      "description": "Tests under AddressSanitizer and UndefinedBehaviorSanitizer (RULES.md D14)",
      "steps": [
        {
          "type": "configure",
          "name": "asan-ubsan"
        },
        {
          "type": "build",
          "name": "asan-ubsan"
        },
        {
          "type": "test",
          "name": "asan-ubsan"
        }
      ]
    },
    {
      "name": "coverage",
      "displayName": "coverage",
      "description": "Tests measured by Clang's source-based coverage, against the floors (RULES.md D7)",
      "steps": [
        {
          "type": "configure",
          "name": "coverage"
        },
        {
          "type": "build",
          "name": "coverage"
        },
        {
          "type": "test",
          "name": "coverage"
        },
        {
          "type": "build",
          "name": "coverage-report"
        }
      ]
    },
    {
      "name": "verify",
      "displayName": "verify",
      "description": "Every check a change must pass: clang-tidy, format, source rules, docs and tests (R-PROC-1)",
      "steps": [
        {
          "type": "configure",
          "name": "verify"
        },
        {
          "type": "build",
          "name": "verify"
        },
        {
          "type": "test",
          "name": "verify"
        }
      ]
    }
  ]
}
