# The CMake package of turborel-cpp: `find_package(turborel-cpp CONFIG)`
# gives the target `turborel::turborel-cpp` (RULES.md D9).
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(turborel @PROJECT_VERSION@ EXACT CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/turborel-cpp-targets.cmake")
check_required_components(turborel-cpp)
