# The tests' clang-tidy: the project's, less what Catch2's macros cannot
# meet, and literal fixtures (R-CONST-5).
---
InheritParentConfig: true
Checks: >
  -readability-magic-numbers,
  -cppcoreguidelines-avoid-do-while,
  -readability-function-cognitive-complexity,
  -cert-err58-cpp,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -misc-use-anonymous-namespace
# readability-magic-numbers: tests use literal fixtures (R-CONST-5).
# cppcoreguidelines-avoid-do-while, readability-function-cognitive-
#   complexity: Catch2's assertion macros expand to do-while loops and
#   branches the test itself does not write.
# cert-err58-cpp, cppcoreguidelines-avoid-non-const-global-variables,
#   misc-use-anonymous-namespace: TEST_CASE registers each test by a
#   static object Catch2's macro defines.
...
